import java.util.Scanner;
public class new1{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter val:");
        int n = sc.nextInt();
        int sum=0;
        while (n>0){
            int d=n%10;
            sum = sum +d;
            n = n/10;
        }
        System.out.println("Sum is :"+sum);
    }
}


