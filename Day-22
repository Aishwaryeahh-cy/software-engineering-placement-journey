import java.util.Scanner;
public class new1{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int [] num = new int[5];
        int sum=0;
        System.out.println("Enter 5 values:");
        for(int i =0; i<num.length; i++ ){
            num[i]= sc.nextInt();
        }
        for(int i =0; i<num.length; i++ ){
            sum=sum+num[i];
        }

        System.out.println(sum);
